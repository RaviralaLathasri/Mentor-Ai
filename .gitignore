# ============================================================================
# MENTOR AI - COMPREHENSIVE .gitignore
# ============================================================================
# Ignore OS and IDE specific files, dependencies, and sensitive data
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# PYTHON & VIRTUAL ENVIRONMENTS
# ─────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Virtual environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
.venv.bak/
virtual_env/

# Poetry
poetry.lock

# Pipenv
Pipfile.lock

# Pipenv Pipfile
.Pipfile

# ─────────────────────────────────────────────────────────────────────────
# NODE.JS & FRONTEND
# ─────────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
/dist/
/build/
/frontend/dist/
/frontend/build/

# Frontend package managers
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─────────────────────────────────────────────────────────────────────────
# ENVIRONMENT & SECRETS (IMPORTANT!)
# ─────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.dev
.env.prod
!.env.example

# API keys and credentials
*.key
*.pem
*.cert
*.pub
.aws/
.secrets/

# ─────────────────────────────────────────────────────────────────────────
# IDE & EDITOR FILES
# ─────────────────────────────────────────────────────────────────────────
# VSCode
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm
.idea/
*.iml
*.iws
*.ipr
*.sublime-workspace

# VS
.vs/

# Vim
.swp
.swo
*~
.vimrc

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# ─────────────────────────────────────────────────────────────────────────
# OPERATING SYSTEM FILES
# ─────────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
*.swp
._*

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# ─────────────────────────────────────────────────────────────────────────
# DATABASE & DATA FILES
# ─────────────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
mentor_ai.db
*.db-wal
*.db-shm

# ─────────────────────────────────────────────────────────────────────────
# DOCKER & CONTAINERIZATION
# ─────────────────────────────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ─────────────────────────────────────────────────────────────────────────
# LOGS & TEMPORARY FILES
# ─────────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*
tmp/
temp/
*.tmp

# ─────────────────────────────────────────────────────────────────────────
# BUILD & DIST
# ─────────────────────────────────────────────────────────────────────────
build/
dist/
*.whl
*.tar.gz
.cache/

# ─────────────────────────────────────────────────────────────────────────
# TESTING & COVERAGE
# ─────────────────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage*
.tox/
.hypothesis/

# ─────────────────────────────────────────────────────────────────────────
# CACHING
# ─────────────────────────────────────────────────────────────────────────
.cache/
*.cache
*.pickle
*.pkl
.webassets-cache

# ─────────────────────────────────────────────────────────────────────────
# PYTHON DEBUGGING
# ─────────────────────────────────────────────────────────────────────────
.ipynb_checkpoints
*.ipynb_checkpoints

# ─────────────────────────────────────────────────────────────────────────
# MISC
# ─────────────────────────────────────────────────────────────────────────
.DS_Store
._*
.localized
.agignore
*.md.bak
.versionrc.json

# Frontend build output
frontend/dist/

# Backend build output
build/
dist/
*.egg-info/

# Redis
dump.rdb
appendonly.aof

# Databases / local state
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Frontend build artifacts
node_modules/
frontend/dist/

# Local dev tooling
.dev/
