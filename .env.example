# ============================================================================
# MENTOR AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in the values for your environment
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# For local development (SQLite):
DATABASE_URL=sqlite:///./mentor_ai.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/mentor_ai

# ─────────────────────────────────────────────────────────────────────────
# CORS & SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Frontend URLs allowed to communicate with backend (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Enable log colors in console output
# LOG_COLORS=1

# Optional: Disable Uvicorn access logs for cleaner output
# UVICORN_ACCESS_LOG=0
# UVICORN_ACCESS_LOG_LEVEL=WARNING

# ─────────────────────────────────────────────────────────────────────────
# LLM PROVIDER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Choose between:
# 1. OpenAI (https://platform.openai.com)
# 2. OpenRouter (https://openrouter.ai) - Recommended for cost-efficiency

# Option A: OpenAI Configuration
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_MODEL=gpt-3.5-turbo

# Option B: OpenRouter Configuration (Recommended)
# For free/cheap models, use: openrouter/auto
# For specific model, use: openrouter/anthropic/claude-3-haiku
# See https://openrouter.ai/models for full list

OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_API_MODEL=openrouter/auto

# OpenRouter metadata (required for OpenRouter)
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Mentor AI

# ─────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION (for Audio Interview System)
# ─────────────────────────────────────────────────────────────────────────
# Redis Backend Options:
# - "redis": Production-ready Redis backend
# - "memory": In-memory store (development only, cleared on restart)
# If left blank/unset, system will auto-detect Redis and fall back to memory

# Redis Connection
REDIS_URL=redis://127.0.0.1:6379/0

# Redis Connection Timeouts
REDIS_SOCKET_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=2.0

# Interview System Configuration
INTERVIEW_STORE_BACKEND=memory
INTERVIEW_SESSION_TTL_SECONDS=7200

# ─────────────────────────────────────────────────────────────────────────
# NOTES
# ─────────────────────────────────────────────────────────────────────────
# 1. Never commit .env file with actual secrets - it's in .gitignore
# 2. Always restart backend after changing .env values
# 3. For Windows development Redis: run scripts\dev_redis.ps1
# 4. See README.md and DEPLOYMENT_GUIDE.md for more details

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1

# Groq Whisper (STT)
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_WHISPER_TEMPERATURE=0

# STT chunking (controls how quickly transcripts appear; smaller = more API calls)
# Recommended: start at ~3s to avoid STT rate limits, then tune down if your plan allows.
STT_SEGMENT_SECONDS=3.0

# Optional STT tuning
# Force Whisper transcription language (ISO-639-1, e.g. "en", "hi"). Leave blank for auto-detect.
STT_LANGUAGE=
# Silence gate (mean abs amplitude in PCM16). Helps avoid hallucinated text on silent chunks.
STT_MIN_MEAN_ABS=250
# Throttle partial transcripts (helps avoid 429 Too Many Requests).
STT_MIN_INTERVAL_SECONDS=2.5
# Backoff applied after a 429 from the STT provider.
STT_RATE_LIMIT_COOLDOWN_SECONDS=15

# Logging (dev defaults)
LOG_LEVEL=INFO
# LOG_COLORS=1
# UVICORN_ACCESS_LOG=0
# UVICORN_ACCESS_LOG_LEVEL=WARNING

# Optional LLM provider settings
OPENAI_API_KEY=
OPENAI_API_BASE=
# For OpenRouter, "openrouter/auto" is recommended.
OPENAI_API_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Mentor AI

# Audio Interview System (Redis + STT + TTS)
# Interview store backend:
# - "redis" (recommended for production)
# - "memory" (dev-only fallback; process-local, cleared on restart)
# If left blank/unset, the backend will auto-detect Redis and fall back to memory if Redis is unavailable.
INTERVIEW_STORE_BACKEND=
# Windows dev: you can start a local Redis with `powershell -ExecutionPolicy Bypass -File scripts\\dev_redis.ps1`.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=2.0
INTERVIEW_SESSION_TTL_SECONDS=7200

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1

# Groq Whisper (STT)
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_WHISPER_TEMPERATURE=0

# STT chunking (controls how quickly transcripts appear; smaller = more API calls)
# Recommended: start at ~3s to avoid STT rate limits, then tune down if your plan allows.
STT_SEGMENT_SECONDS=3.0

# Optional STT tuning
# Force Whisper transcription language (ISO-639-1, e.g. "en", "hi"). Leave blank for auto-detect.
STT_LANGUAGE=
# Silence gate (mean abs amplitude in PCM16). Helps avoid hallucinated text on silent chunks.
STT_MIN_MEAN_ABS=250
# Throttle partial transcripts (helps avoid 429 Too Many Requests).
STT_MIN_INTERVAL_SECONDS=2.5
# Backoff applied after a 429 from the STT provider.
STT_RATE_LIMIT_COOLDOWN_SECONDS=15
